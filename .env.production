# 生产构建（GitHub Actions / vite build）使用的公开配置。
# 本文件刻意纳入版本库：里面只有前端可读的公开值。
#
# 2026-11-28：已断开 CloudBase。LunaSol 现在是纯静态站点 + BYOK，
# 前端不再包含任何腾讯云域名，也不再依赖任何后端。
#
# 下面三项已清空：清空后 cloudConfigured=false，登录/积分/云同步整条链路
# 在构建期就被判定为不可用，不会发出任何请求。
# 需要恢复账号体系时，把 CloudBase 环境 ID 与 publishable key 填回来即可。
VITE_CLOUDBASE_ENV_ID=
VITE_CLOUDBASE_REGION=ap-shanghai
VITE_CLOUDBASE_PUBLISHABLE_KEY=

# AI 代理地址已删除：所有 AI 调用改为用户在设置页填自己的 Key，
# 由浏览器直接发往厂商（见 src/cloud/vendors.ts）。
# 留空后 proxy 模式无法生效，只有 browser 直连可用 —— 这是刻意为之。
VITE_LUNASOL_AI_BASE_URL=
VITE_LUNASOL_AI_TOKEN=
