# LunaSol 公开配置模板
# 这些都是可以随前端代码一起发布的公开值，不是密钥。
# 厂商模型密钥（DEEPSEEK_API_KEY）只保存在 CloudBase 云函数环境变量中，绝不写在这里。

# CloudBase 国内站环境（ap-shanghai）
VITE_CLOUDBASE_ENV_ID=
VITE_CLOUDBASE_REGION=ap-shanghai
# Publishable Key：只允许公布在前端，服务端会按 Origin 与登录态校验
VITE_CLOUDBASE_PUBLISHABLE_KEY=

# DeepSeek 后台代理（CloudBase HTTP 云函数网关路径）
VITE_LUNASOL_AI_BASE_URL=
# 代理访问令牌：不是厂商密钥，用于防止代理被任意站点调用
VITE_LUNASOL_AI_TOKEN=
